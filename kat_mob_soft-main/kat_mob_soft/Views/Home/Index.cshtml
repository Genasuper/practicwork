@model List<PraticProect.Models.Equipment>
@{
    ViewData["Title"] = "Аренда фототехники";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-4">Аренда профессиональной фототехники</h1>
        <p class="lead">Камеры, объективы, освещение и аксессуары для вашего творчества</p>
        <a href="@Url.Action("Equipment")" class="btn btn-light btn-lg">Смотреть каталог</a>
    </div>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-4">Популярное оборудование</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 equipment-card">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 250px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted">@item.Brand @item.Model</p>
                        <p class="card-text">@item.Description</p>
                        <div class="mt-auto">
                            <p class="card-text"><strong>@item.PricePerDay.ToString("N0") руб./день</strong></p>
                            <a href="@Url.Action("Rent", new { id = item.Id })" class="btn btn-primary">Арендовать</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-4">Почему выбирают нас?</h2>

    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <div class="feature-icon">📷</div>
            <h4>Качественное оборудование</h4>
            <p>Только оригинальная и регулярно обслуживаемая техника</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-icon">🚚</div>
            <h4>Быстрая доставка</h4>
            <p>Доставка в день заказа по всему городу</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-icon">💬</div>
            <h4>Поддержка 24/7</h4>
            <p>Всегда готовы помочь с выбором и консультацией</p>
        </div>
    </div>
</div>

<style>
    .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

        .feature-icon + h4 {
            color: #ff6b35;
            margin-bottom: 1rem;
        }
</style>
<!-- Секция "Написать сообщение" -->
<section class="contact-message-section">
    <div class="container">
        <h2>Написать сообщение</h2>
        <div class="contact-form-wrapper">
            <form class="contact-form" id="message-form">
                <div class="form-row">
                    <div class="input-group">
                        <input type="text" id="message-name" required placeholder=" ">
                        <label for="message-name">Ваше имя</label>
                    </div>
                    <div class="input-group">
                        <input type="email" id="message-email" required placeholder=" ">
                        <label for="message-email">Ваш email</label>
                    </div>
                </div>
                <div class="input-group">
                    <input type="text" id="message-subject" required placeholder=" ">
                    <label for="message-subject">Тема сообщения</label>
                </div>
                <div class="input-group">
                    <textarea id="message-text" required placeholder=" " rows="5"></textarea>
                    <label for="message-text">Ваше сообщение</label>
                </div>
                <button type="submit" class="btn-send-message">Отправить сообщение</button>
            </form>
        </div>
    </div>
</section>