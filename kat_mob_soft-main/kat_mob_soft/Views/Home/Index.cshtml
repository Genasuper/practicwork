@model List<PraticProect.Models.Equipment>
@{
    Layout = "_Layout";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-4">Аренда профессиональной фототехники</h1>
        <p class="lead">Камеры, объективы, освещение и аксессуары для вашего творчества</p>
        <a href="@Url.Action("Equipment")" class="btn btn-light btn-lg">Смотреть каталог</a>
    </div>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-4">Популярное оборудование</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 equipment-card">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 250px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted">@item.Category</p>
                        <p class="card-text">@item.Description</p>
                        <div class="mt-auto">
                            <p class="card-text"><strong>@item.PricePerDay.ToString("N0") руб./день</strong></p>
                            <a href="@Url.Action("Rent", new { id = item.Id })" class="btn btn-primary">Арендовать</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-4">Почему выбирают нас?</h2>

    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <div class="feature-icon">📷</div>
            <h4>Качественное оборудование</h4>
            <p>Только оригинальная и регулярно обслуживаемая техника</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-icon">🚚</div>
            <h4>Быстрая доставка</h4>
            <p>Доставка в день заказа по всему городу</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-icon">💬</div>
            <h4>Поддержка 24/7</h4>
            <p>Всегда готовы помочь с выбором и консультацией</p>
        </div>
    </div>
</div>

<!-- Секция "Написать сообщение" -->
<section class="contact-message-section mt-5">
    <div class="container">
        <h2 class="text-center mb-4">Написать сообщение</h2>
        <div class="contact-form-wrapper">
            <form class="contact-form" id="message-form">
                <div class="form-row">
                    <div class="input-group">
                        <input type="text" id="message-name" required placeholder=" ">
                        <label for="message-name">Ваше имя</label>
                    </div>
                    <div class="input-group">
                        <input type="email" id="message-email" required placeholder=" ">
                        <label for="message-email">Ваш email</label>
                    </div>
                </div>
                <div class="input-group">
                    <input type="text" id="message-subject" required placeholder=" ">
                    <label for="message-subject">Тема сообщения</label>
                </div>
                <div class="input-group">
                    <textarea id="message-text" required placeholder=" " rows="5"></textarea>
                    <label for="message-text">Ваше сообщение</label>
                </div>
                <button type="submit" class="btn-send-message">Отправить сообщение</button>
            </form>
        </div>
    </div>
</section>

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 100px 0;
        text-align: center;
    }

    .equipment-card {
        transition: transform 0.3s;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .equipment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.2);
        }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .contact-form-wrapper {
        background: #f8f9fa;
        padding: 2rem;
        border-radius: 10px;
        max-width: 800px;
        margin: 0 auto;
    }

    .input-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .input-group input,
        .input-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background: white;
        }

        .input-group label {
            position: absolute;
            top: 10px;
            left: 10px;
            transition: all 0.3s;
            background: white;
            padding: 0 5px;
            color: #999;
        }

        .input-group input:focus + label,
        .input-group textarea:focus + label,
        .input-group input:not(:placeholder-shown) + label,
        .input-group textarea:not(:placeholder-shown) + label {
            top: -10px;
            font-size: 12px;
            color: #667eea;
        }

    .btn-send-message {
        background: #667eea;
        color: white;
        border: none;
        padding: 10px 30px;
        border-radius: 5px;
        cursor: pointer;
        display: block;
        margin: 0 auto;
    }

        .btn-send-message:hover {
            background: #5a6fd8;
        }
</style>