@model List<PraticProect.Models.Equipment>
@{
    ViewData["Title"] = "Каталог оборудования";
}

<div class="container">
    <h1 class="mb-4">Каталог оборудования</h1>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <img src="@item.ImageUrl" class="img-fluid rounded-start" alt="@item.Name" style="height: 200px; width: 100%; object-fit: cover;">
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text"><small class="text-muted">@item.Category • @item.Name</small></p>
                                <p class="card-text">@item.Description</p>
                                <p class="card-text"><strong>@item.PricePerDay.ToString("N0") руб./день</strong></p>
                                @if (item.IsAvailable)
                                {
                                    <a href="@Url.Action("Rent", new { id = item.Id })" class="btn btn-success">Арендовать</a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>Недоступно</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>