@* Views/Shared/_LoginRegistrationPartial.cshtml *@
<div class="overlay" id="overlay"></div>

<!-- Форма входа -->
<div class="container-form login-form" id="login-form">
    <div class="form-container">
        <button class="btn-close-form" id="btn-close-login" title="Закрыть">×</button>

        <div class="form-content">
            <h2>Вход в аккаунт</h2>

            <div class="input-group">
                <input type="email" id="login-email" required placeholder=" ">
                <label for="login-email">Email</label>
            </div>

            <div class="input-group">
                <input type="password" id="login-password" required placeholder=" ">
                <label for="login-password">Пароль</label>
            </div>

            <button type="button" class="btn-submit" id="btn-login-submit">Войти</button>
            <a href="#" class="forgot-password">Забыли пароль?</a>

            <div class="form-switch">
                <p>Нет аккаунта? <a href="#" class="switch-to-register">Зарегистрироваться</a></p>
            </div>
        </div>
    </div>
</div>

<!-- Форма регистрации -->
<div class="container-form register-form" id="register-form">
    <div class="form-container">
        <button class="btn-close-form" id="btn-close-register" title="Закрыть">×</button>

        <div class="form-content">
            <h2>Создать аккаунт</h2>

            <div class="input-group">
                <input type="text" id="register-name" required placeholder=" ">
                <label for="register-name">Имя</label>
            </div>

            <div class="input-group">
                <input type="email" id="register-email" required placeholder=" ">
                <label for="register-email">Email</label>
            </div>

            <div class="input-group">
                <input type="password" id="register-password" required placeholder=" ">
                <label for="register-password">Пароль</label>
            </div>

            <div class="input-group">
                <input type="password" id="register-confirm" required placeholder=" ">
                <label for="register-confirm">Подтвердите пароль</label>
            </div>

            <button type="button" class="btn-submit" id="btn-register-submit">Зарегистрироваться</button>

            <div class="form-switch">
                <p>Уже есть аккаунт? <a href="#" class="switch-to-login">Войти</a></p>
            </div>
        </div>
    </div>
</div>