@using Microsoft.AspNetCore.Identity

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentPhoto</title>
    <link rel="stylesheet" href="~/css/shared.css" />
    <script src="~/js/shared_script.js" defer></script>
</head>
<body>
    <header id="header">
        <!-- Верхняя часть шапки -->
        <div class="top-header">
            <div class="logo">RentPhoto</div>
            <div class="auth-buttons">
                <button class="btn-login">Войти</button>
                <button class="btn-register">Зарегистрироваться</button>
            </div>
        </div>

        <!-- Центральная часть -->
        <div class="center-header">
            <img src="~/images/header-photo.jpg" alt="Фототехника в аренду" class="header-image" />
        </div>

        <!-- Нижняя часть шапки -->
        <nav class="bottom-header">
            <ul class="menu">
                <li><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li><a asp-controller="Home" asp-action="SiteInformation">О нас</a></li>
                <li><a asp-controller="Catalog" asp-action="Index">Каталог</a></li>
                <li><a asp-controller="Home" asp-action="Contacts">Контакты</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        @RenderBody()
    </div>
</body>
</html>
