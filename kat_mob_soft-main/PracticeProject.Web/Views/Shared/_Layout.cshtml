<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Аренда фототехники</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
</head>
<body>
    <!-- Фиксированная шапка -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background: #8b5cf6; border-bottom: 2px solid #7c3aed; box-shadow: 0 2px 20px rgba(139, 92, 246, 0.3);">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")" style="font-weight: bold; font-size: 1.5rem; color: white;">📷 ФОТОТЕХНИКА</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <div class="navbar-nav me-auto">
                    <a class="nav-link" href="@Url.Action("Index", "Home")" style="color: white;">Главная</a>
                    <a class="nav-link" href="@Url.Action("Equipment", "Home")" style="color: white;">Каталог</a>
                    <a class="nav-link" href="@Url.Action("About", "Home")" style="color: white;">О нас</a>
                    <a class="nav-link" href="@Url.Action("Contact", "Home")" style="color: white;">Контакты</a>
                    <a class="nav-link" href="@Url.Action("MyRentals", "Home")" style="color: white;">Мои аренды</a>
                </div>
                <div class="navbar-nav ms-auto" id="authSection">
                    <button class="btn me-2" id="themeToggle" style="border: 2px solid white; color: white; background: transparent; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-moon"></i>
                    </button>
                    <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#loginModal" style="color: white;">
                        <i class="fas fa-sign-in-alt"></i> Войти
                    </a>
                    <a class="btn ms-2" href="#" data-bs-toggle="modal" data-bs-target="#registerModal" style="border: 2px solid white; color: white; background: transparent; border-radius: 8px; padding: 8px 20px;">
                        <i class="fas fa-user-plus"></i> Зарегистрироваться
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Отступ для шапки -->
    <div style="height: 80px;"></div>

    <!-- Основной контент -->
    <main>
        @RenderBody()
    </main>

    <!-- Футер -->
    <footer class="text-white text-center py-4 mt-5" style="background: #8b5cf6; border-top: 2px solid #7c3aed;">
        <div class="container">
            <p>&copy; 2025 Аренда профессиональной фототехники</p>
            <p class="mb-0">Телефон: +7 (373) 777-91-115</p>
        </div>
    </footer>

    <!-- Модальное окно входа -->
    <div class="modal fade" id="loginModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Вход в систему</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="loginForm">
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="loginEmail" required>
                            <div class="invalid-feedback">Пожалуйста, введите корректный email</div>
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Пароль</label>
                            <input type="password" class="form-control" id="loginPassword" required>
                            <div class="invalid-feedback">Пожалуйста, введите пароль</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100" id="loginButton">
                            <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                            Войти
                        </button>
                        <div class="alert alert-danger mt-3 d-none" id="loginError"></div>
                        <div class="alert alert-success mt-3 d-none" id="loginSuccess"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Модальное окно регистрации -->
    <div class="modal fade" id="registerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Регистрация</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="registerForm">
                        <div class="mb-3">
                            <label for="regName" class="form-label">Имя</label>
                            <input type="text" class="form-control" id="regName" required>
                            <div class="invalid-feedback">Пожалуйста, введите ваше имя</div>
                        </div>
                        <div class="mb-3">
                            <label for="regEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="regEmail" required>
                            <div class="invalid-feedback">Пожалуйста, введите корректный email</div>
                        </div>
                        <div class="mb-3">
                            <label for="regPassword" class="form-label">Пароль</label>
                            <input type="password" class="form-control" id="regPassword" required minlength="6">
                            <div class="invalid-feedback">Пароль должен содержать минимум 6 символов</div>
                        </div>
                        <div class="mb-3">
                            <label for="regConfirmPassword" class="form-label">Подтвердите пароль</label>
                            <input type="password" class="form-control" id="regConfirmPassword" required>
                            <div class="invalid-feedback">Пароли не совпадают</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100" id="registerButton">
                            <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                            Зарегистрироваться
                        </button>
                        <div class="alert alert-danger mt-3 d-none" id="registerError"></div>
                        <div class="alert alert-success mt-3 d-none" id="registerSuccess"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Скрипт для темы -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggle = document.getElementById('themeToggle');
            const body = document.body;

            // Проверяем сохраненную тему
            if (localStorage.getItem('darkTheme') === 'true') {
                enableDarkTheme();
            }

            // Обработчик кнопки
            themeToggle.addEventListener('click', function() {
                if (body.style.backgroundColor === 'rgb(10, 10, 10)') {
                    disableDarkTheme();
                } else {
                    enableDarkTheme();
                }
            });

            function enableDarkTheme() {
                body.style.backgroundColor = '#0a0a0a';
                body.style.color = '#ffffff';

                // Меняем фон карточек
                document.querySelectorAll('.card, .equipment-card').forEach(card => {
                    card.style.backgroundColor = '#1a1a1a';
                    card.style.color = '#ffffff';
                    card.style.borderColor = '#333';
                });

                // Меняем модальные окна
                document.querySelectorAll('.modal-content').forEach(modal => {
                    modal.style.backgroundColor = '#1a1a1a';
                    modal.style.color = '#ffffff';
                });

                // Меняем формы
                document.querySelectorAll('.form-control').forEach(input => {
                    input.style.backgroundColor = '#2d2d2d';
                    input.style.color = '#ffffff';
                    input.style.borderColor = '#444';
                });

                localStorage.setItem('darkTheme', 'true');
                updateThemeIcon(true);
            }

            function disableDarkTheme() {
                body.style.backgroundColor = '';
                body.style.color = '';

                // Возвращаем светлую тему карточкам
                document.querySelectorAll('.card, .equipment-card').forEach(card => {
                    card.style.backgroundColor = '';
                    card.style.color = '';
                    card.style.borderColor = '';
                });

                // Возвращаем светлую тему модальным окнам
                document.querySelectorAll('.modal-content').forEach(modal => {
                    modal.style.backgroundColor = '';
                    modal.style.color = '';
                });

                // Возвращаем светлую тему формам
                document.querySelectorAll('.form-control').forEach(input => {
                    input.style.backgroundColor = '';
                    input.style.color = '';
                    input.style.borderColor = '';
                });

                localStorage.setItem('darkTheme', 'false');
                updateThemeIcon(false);
            }

            function updateThemeIcon(isDark) {
                const icon = themeToggle.querySelector('i');
                if (isDark) {
                    icon.className = 'fas fa-sun';
                    themeToggle.title = 'Переключить на светлую тему';
                } else {
                    icon.className = 'fas fa-moon';
                    themeToggle.title = 'Переключить на темную тему';
                }
            }
        });
    </script>

    <!-- Fetch запросы для форм -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Форма входа
            const loginForm = document.getElementById('loginForm');
            const loginButton = document.getElementById('loginButton');
            const loginError = document.getElementById('loginError');
            const loginSuccess = document.getElementById('loginSuccess');

            loginForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                if (!loginForm.checkValidity()) {
                    e.stopPropagation();
                    loginForm.classList.add('was-validated');
                    return;
                }

                const email = document.getElementById('loginEmail').value;
                const password = document.getElementById('loginPassword').value;

                // Показываем загрузку
                loginButton.querySelector('.spinner-border').classList.remove('d-none');
                loginButton.disabled = true;
                loginError.classList.add('d-none');
                loginSuccess.classList.add('d-none');

                try {
                    // Реальный Fetch запрос
                    const response = await fetch('/api/auth/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            email: email,
                            password: password
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Успешный вход
                        loginSuccess.textContent = data.message;
                        loginSuccess.classList.remove('d-none');

                        // Сохраняем данные пользователя
                        localStorage.setItem('currentUser', JSON.stringify(data.user));
                        localStorage.setItem('isLoggedIn', 'true');

                        // Обновляем интерфейс
                        updateUserInterface(data.user);

                        // Закрываем модальное окно
                        setTimeout(() => {
                            const modal = bootstrap.Modal.getInstance(document.getElementById('loginModal'));
                            modal.hide();
                            loginForm.reset();
                            loginForm.classList.remove('was-validated');
                        }, 2000);
                    } else {
                        // Ошибка входа
                        throw new Error(data.message);
                    }

                } catch (error) {
                    // Обработка ошибки
                    loginError.textContent = error.message || 'Ошибка соединения с сервером';
                    loginError.classList.remove('d-none');
                } finally {
                    // Скрываем загрузку
                    loginButton.querySelector('.spinner-border').classList.add('d-none');
                    loginButton.disabled = false;
                }
            });

            // Форма регистрации
            const registerForm = document.getElementById('registerForm');
            const registerButton = document.getElementById('registerButton');
            const registerError = document.getElementById('registerError');
            const registerSuccess = document.getElementById('registerSuccess');

            // Проверка совпадения паролей в реальном времени
            document.getElementById('regConfirmPassword').addEventListener('input', function() {
                const password = document.getElementById('regPassword').value;
                const confirmPassword = this.value;

                if (password !== confirmPassword) {
                    this.setCustomValidity('Пароли не совпадают');
                    this.classList.add('is-invalid');
                } else {
                    this.setCustomValidity('');
                    this.classList.remove('is-invalid');
                }
            });

            registerForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                if (!registerForm.checkValidity()) {
                    e.stopPropagation();
                    registerForm.classList.add('was-validated');
                    return;
                }

                const name = document.getElementById('regName').value;
                const email = document.getElementById('regEmail').value;
                const password = document.getElementById('regPassword').value;

                // Показываем загрузку
                registerButton.querySelector('.spinner-border').classList.remove('d-none');
                registerButton.disabled = true;
                registerError.classList.add('d-none');
                registerSuccess.classList.add('d-none');

                try {
                    // Реальный Fetch запрос
                    const response = await fetch('/api/auth/register', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            name: name,
                            email: email,
                            password: password
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Успешная регистрация
                        registerSuccess.textContent = data.message;
                        registerSuccess.classList.remove('d-none');

                        // Закрываем модальное окно и открываем вход
                        setTimeout(() => {
                            const modal = bootstrap.Modal.getInstance(document.getElementById('registerModal'));
                            modal.hide();
                            registerForm.reset();
                            registerForm.classList.remove('was-validated');

                            // Автоматически заполняем форму входа
                            document.getElementById('loginEmail').value = email;
                            const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                            loginModal.show();
                        }, 3000);
                    } else {
                        // Ошибка регистрации
                        throw new Error(data.message);
                    }

                } catch (error) {
                    // Обработка ошибки
                    registerError.textContent = error.message || 'Ошибка соединения с сервером';
                    registerError.classList.remove('d-none');
                } finally {
                    // Скрываем загрузку
                    registerButton.querySelector('.spinner-border').classList.add('d-none');
                    registerButton.disabled = false;
                }
            });

            // Функция обновления интерфейса после входа
            function updateUserInterface(user) {
                const authSection = document.getElementById('authSection');
                if (authSection) {
                    authSection.innerHTML = `
                        <button class="btn me-2" id="themeToggle" style="border: 2px solid white; color: white; background: transparent; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-moon"></i>
                        </button>
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" style="color: white;">
                                <i class="fas fa-user"></i> ${user.name}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Home/MyRentals">Мои аренды</a></li>
                                <li><a class="dropdown-item" href="#">Профиль</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#" onclick="logout()">Выйти</a></li>
                            </ul>
                        </div>
                    `;

                    // Переинициализируем кнопку темы
                    initializeTheme();
                }
            }

            // Функция выхода
            window.logout = function() {
                localStorage.removeItem('currentUser');
                localStorage.removeItem('isLoggedIn');
                location.reload();
            };

            // Функция инициализации темы
            function initializeTheme() {
                const themeToggle = document.getElementById('themeToggle');
                const body = document.body;

                if (themeToggle) {
                    themeToggle.addEventListener('click', function() {
                        if (body.style.backgroundColor === 'rgb(10, 10, 10)') {
                            body.style.backgroundColor = '';
                            body.style.color = '';
                            localStorage.setItem('darkTheme', 'false');
                            updateThemeIcon(false);
                        } else {
                            body.style.backgroundColor = '#0a0a0a';
                            body.style.color = '#ffffff';
                            localStorage.setItem('darkTheme', 'true');
                            updateThemeIcon(true);
                        }
                    });

                    function updateThemeIcon(isDark) {
                        const icon = themeToggle.querySelector('i');
                        if (isDark) {
                            icon.className = 'fas fa-sun';
                            themeToggle.title = 'Переключить на светлую тему';
                        } else {
                            icon.className = 'fas fa-moon';
                            themeToggle.title = 'Переключить на темную тему';
                        }
                    }
                }
            }

            // Проверяем авторизацию при загрузке
            const currentUser = localStorage.getItem('currentUser');
            if (currentUser) {
                updateUserInterface(JSON.parse(currentUser));
            }

            // Сброс форм при закрытии модальных окон
            document.getElementById('loginModal').addEventListener('hidden.bs.modal', function() {
                loginForm.reset();
                loginForm.classList.remove('was-validated');
                loginError.classList.add('d-none');
                loginSuccess.classList.add('d-none');
            });

            document.getElementById('registerModal').addEventListener('hidden.bs.modal', function() {
                registerForm.reset();
                registerForm.classList.remove('was-validated');
                registerError.classList.add('d-none');
                registerSuccess.classList.add('d-none');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>