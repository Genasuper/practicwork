@{
    ViewData["Title"] = "Наши услуги и контакты";
}

<!-- Секция Наши услуги -->
<section class="services-section">
    <div class="container">
        <h2 class="section-title">Наши услуги</h2>
        <div class="services-container">
            <button class="arrow left-arrow">‹</button>
            <div class="services-wrapper">
                <div class="services-track">
                    <!-- Карточка 1 - Аренда фотоаппаратов -->
                    <div class="service-card">
                        <div class="service-image">
                            <img src="https://images.unsplash.com/photo-1502920917128-1aa500764cbd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Аренда фотоаппаратов">
                        </div>
                        <div class="service-content">
                            <h3 class="service-title">Аренда фотоаппаратов</h3>
                            <p class="service-description">
                                Профессиональные зеркальные и беззеркальные камеры для любых видов съемки.
                                От любительских моделей до топовых профессиональных решений.
                            </p>
                        </div>
                    </div>
                    <!-- Карточка 2 - Аренда объективов -->
                    <div class="service-card">
                        <div class="service-image">
                            <img src="https://images.unsplash.com/photo-1606983340126-99ab4feaa64a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Аренда объективов">
                        </div>
                        <div class="service-content">
                            <h3 class="service-title">Аренда объективов</h3>
                            <p class="service-description">
                                Широкий выбор объективов: портретные, макро, широкоугольные, телеобъективы.
                                Подберем оптику под ваши творческие задачи.
                            </p>
                        </div>
                    </div>
                    <!-- Карточка 3 - Студийное оборудование -->
                    <div class="service-card">
                        <div class="service-image">
                            <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Студийное оборудование">
                        </div>
                        <div class="service-content">
                            <h3 class="service-title">Студийное оборудование</h3>
                            <p class="service-description">
                                Полный комплект для студийной съемки: импульсные и постоянные источники света,
                                софтбоксы, стойки, фоны и аксессуары.
                            </p>
                        </div>
                    </div>
                    <!-- Карточка 4 - Видеотехника -->
                    <div class="service-card">
                        <div class="service-image">
                            <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Видеотехника">
                        </div>
                        <div class="service-content">
                            <h3 class="service-title">Видеотехника</h3>
                            <p class="service-description">
                                Оборудование для видеосъемки: видеокамеры, стабилизаторы, микрофоны,
                                осветительные приборы для создания качественного видео.
                            </p>
                        </div>
                    </div>
                    <!-- Карточка 5 - Аксессуары -->
                    <div class="service-card">
                        <div class="service-image">
                            <img src="https://images.unsplash.com/photo-1542751110-97427bbecf20?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Аксессуары">
                        </div>
                        <div class="service-content">
                            <h3 class="service-title">Аксессуары</h3>
                            <p class="service-description">
                                Штативы, фильтры, батареи, карты памяти, сумки и рюкзаки. Все необходимое
                                для комфортной работы фотографа.
                            </p>
                        </div>
                    </div>
                    <!-- Карточка 6 - Консультация -->
                    <div class="service-card">
                        <div class="service-image">
                            <img src="https://images.unsplash.com/photo-1556761175-b413da4baf72?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Консультация">
                        </div>
                        <div class="service-content">
                            <h3 class="service-title">Профессиональная консультация</h3>
                            <p class="service-description">
                                Поможем подобрать оборудование под ваш проект. Обучим основам работы
                                с техникой и поделимся секретами профессиональной съемки.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <button class="arrow right-arrow">›</button>
        </div>
    </div>
</section>

<!-- Секция Контакты -->
<section class="contacts-section">
    <div class="container">
        <h2 class="section-title">Контакты</h2>
        <div class="contacts-container">
            <div class="contact-info">
                <div class="contact-item">
                    <div class="contact-icon">📍</div>
                    <div class="contact-details">
                        <h3>Адрес</h3>
                        <p>г. Москва, ул. Фотографов, д. 123</p>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">📞</div>
                    <div class="contact-details">
                        <h3>Телефон</h3>
                        <p>+7 (495) 123-45-67</p>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">✉️</div>
                    <div class="contact-details">
                        <h3>Email</h3>
                        <p>info@photorental.ru</p>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">🕒</div>
                    <div class="contact-details">
                        <h3>Режим работы</h3>
                        <p>Пн-Пт: 9:00-21:00<br>Сб-Вс: 10:00-20:00</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Секция Карта -->
<section class="map-section">
    <div class="container">
        <h2 class="section-title">Мы находимся</h2>
        <div class="map-container">
            <!-- Временная заглушка для карты -->
            <div class="map-placeholder">
                <img src="https://images.unsplash.com/photo-1542744095-291d1f67b221?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80" alt="Наше местоположение" style="width: 100%; height: 400px; object-fit: cover; border-radius: 10px;">
                <div class="map-overlay">
                    <h3>Наш офис</h3>
                    <p>г. Москва, ул. Фотографов, д. 123</p>
                    <p>📍 Карта будет подключена позже</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/home_script.js" asp-append-version="true"></script>
}